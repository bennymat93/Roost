<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Roost.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <!-- Card container -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.65"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Accent button -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="#06231F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Opacity" Value="0.88"/>
    </Style>

    <!-- Sidebar nav items -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AccentColor">#2EC4B8</Color>
          <SolidColorBrush x:Key="AccentBrush" Color="#2EC4B8"/>
          <SolidColorBrush x:Key="CardBrush" Color="#1C2230"/>
          <SolidColorBrush x:Key="CardBorderBrush" Color="#2C3443"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#141925"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AccentColor">#1F9E93</Color>
          <SolidColorBrush x:Key="AccentBrush" Color="#1F9E93"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E6EC"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#F3F5F8"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
